NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_ANNIVERSARY_DATE=2022-06-18
NEXT_PUBLIC_USER_A_NAME=Alex
NEXT_PUBLIC_USER_B_NAME=Sam

# Web Push: generate a key pair with `npx web-push generate-vapid-keys`.
# Put the public key here and the private key only in server-side environment variables.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
PUSH_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Server-only. Each email/password pair must belong to its matching Supabase Auth user.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
USER_A_EMAIL=alex@example.com
USER_A_PASSWORD=replace-with-a-long-random-password
USER_A_PIN_HASH=
USER_B_EMAIL=sam@example.com
USER_B_PASSWORD=replace-with-a-different-long-random-password
USER_B_PIN_HASH=

# Optional LINE Messaging API fallback. Keep these server-only values private.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
